# GitHub username — override when publishing:
#   export GITHUB_USER=your-github-username
GITHUB_USER="${GITHUB_USER:-YOUR_GITHUB_USERNAME}"

# Parent repository name on GitHub
PARENT_REPO="ai-agents-self-learning-and-progress"

# Submodule entries: "local_folder|github_repo_slug|day_label"
SUBMODULES=(
  "ai-day1|day01-ollama-chatbot|Day 1 — Ollama Chat"
  "ai-day2-structured-output|day02-structured-output|Day 2 — Structured Outputs"
  "ai-day3-prompt-engineering|day03-prompt-engineering-email-writer|Day 3 — Prompt Engineering"
  "ai-day4-tools-with-ai|day04-tool-calling|Day 4 — Tool Calling"
  "day5-agent-loop|day05-agent-loop|Day 5 — Agent Loop"
  "day6-fastapi-agent|day06-fastapi-ollama-backend|Day 6 — FastAPI Backend"
  "day7-ai-assistant-ui|day07-react-chat-ui|Day 7 — React Chat UI"
  "day8,9-gmail-agent-learning|day08-09-gmail-api|Day 8–9 — Gmail API"
  "day10-sheets-agent-learning|day10-google-sheets-api|Day 10 — Google Sheets API"
  "day-11,12-email-agent|day11-12-email-agent|Day 11–12 — Email Agent (WIP)"
)
